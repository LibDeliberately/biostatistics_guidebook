nrow() #11
IIBHT %>%
filter(Black == 1) %>%
nrow() #45
IIBHT %>% filter(White == 1 & Hispanic == 1) %>% nrow() #42
IIBHT <- IIBHT %>%
mutate(living_situation = factor(
case_when(
trans_homeless == 1 ~ "Transient/Homeless",
DHS == 1 ~ "Foster Care/DHS Setting",
Residential == 1 ~ "Residential Treatment Center",
jail_pris == 1 ~ "Jail or Prison",
supp_housing == 1 ~ "Supportive Housing",
priv_res == 1 ~ "Private Residence",
unknown_living == 1 ~ "Unknown or Not Listed"
)))
str(IIBHT$living_situation)
IIBHT <- IIBHT %>%
mutate(
household_language = factor(
case_when(
parent_language == "1" ~ "English",
parent_language %in% c("2", "3", "4", "5", "6") ~ "Other Language",
parent_language == "7" ~ "Unknown"
),
levels = c("English", "Other Language", "Unknown")
)
)
str(IIBHT$household_language)
IIBHT <- IIBHT %>%
mutate(
foster_care = factor(
case_when(
# For enrollment_form_used == 1
enrollment_form_used == 1 & hx_foster_care == "3" ~ "None",
enrollment_form_used == 1 & hx_foster_care == "1" & DHS == 0 ~ "History",
enrollment_form_used == 1 & hx_foster_care == "1" & DHS == 1 ~ "Current",
# For enrollment_form_used == 2
enrollment_form_used == 2 & hx_foster_care == "3" ~ "None",
enrollment_form_used == 2 & hx_foster_care == "5" ~ "History",
enrollment_form_used == 2 & hx_foster_care == "2" ~ "Current",
TRUE ~ NA_character_
),
levels = c("None", "History", "Current")
)
)
# Creating a vector of referral variables
referrals <- c( "referral_issue___1","referral_issue___2","referral_issue___3",      "referral_issue___4", "referral_issue___5" )
# Creating max_referral_issue, which finds the first "1" in referrals vector for each observation
IIBHT <- IIBHT %>%
mutate(
max_referral_issue = factor(
apply(select(., all_of(referrals)), 1, function(x) {
# Finding the first column in the referrals vector where x == "1"
idx <- which(x == "1")[1]
# Returningcolumn name, or NA if none
if (!is.na(idx)) {
referrals[idx]
} else {
NA_character_
}
}),
levels = referrals
)
)
# past_services_IDD
IIBHT <- IIBHT %>%
mutate(past_services_IDD = if_else(
services_year_prior___16 == "1" | services_intake___16 == "1", 1, 0
))
# past_services_juv_justice
IIBHT<- IIBHT %>%
mutate(past_services_juv_justice = if_else(
services_year_prior___17 == "1" | services_intake___17 == "1", 1, 0
))
# past_services_wrap
IIBHT <- IIBHT %>%
mutate(past_services_wrap = if_else(
services_year_prior___6 == "1" | services_intake___6 == "1", 1, 0
))
# past_services_sud_treat
IIBHT <- IIBHT %>%
mutate(past_services_sud_treat = if_else(
services_year_prior___11 == "1" | services_intake___11 == "1" |
services_year_prior___12 == "1" | services_intake___12 == "1" |
services_year_prior___14 == "1" | services_intake___14 == "1",
1, 0
))
# past_services_none
#services_year_prior___19—no services accessed during the year prior to IIBHT #enrollment (make sure none of the other services 1 through 18 were selected)
past_services <- c(
"services_year_prior___1","services_intake___1",
"services_year_prior___2","services_intake___2",
"services_year_prior___3","services_intake___3",
"services_year_prior___4","services_intake___4",
"services_year_prior___5","services_intake___5",
"services_year_prior___6","services_intake___6",
"services_year_prior___7","services_intake___7",
"services_year_prior___8","services_intake___8",
"services_year_prior___9","services_intake___9",
"services_year_prior___10","services_intake___10",
"services_year_prior___11","services_intake___11",
"services_year_prior___12","services_intake___12",
"services_year_prior___13","services_intake___13",
"services_year_prior___14","services_intake___14",
"services_year_prior___15","services_intake___15",
"services_year_prior___16","services_intake___16",
"services_year_prior___17","services_intake___17",
"services_year_prior___18","services_intake___18")
IIBHT <- IIBHT %>%
mutate(
past_services_none = case_when(
# If any service in the vector is 1
if_any(all_of(past_services), ~ .x == "1") ~ 0,
# If all service in the vector is 0
if_all(all_of(past_services), ~ .x == "0") &
(services_intake___19 == "1" | services_year_prior___19 == "1") ~ 1,
# If all service in the vector is 0
if_all(all_of(past_services), ~ .x == "0") &
(services_intake___19 == "0" | services_year_prior___19 == "0") ~ 1,
))
# past_services_op_school
IIBHT <- IIBHT %>%
mutate(past_services_op_school = if_else(
services_year_prior___9 == "1" | services_intake___9 == "1" |
services_year_prior___10 == "1" | services_intake___10 == "1" |
services_year_prior___20 == "1" | services_intake___20 == "1" |
services_year_prior___21 == "1" | services_intake___21 == "1",
1, 0
))
#past_services, binary variable that notes whether any of above services have occurred in the year prior OR at intake.
IIBHT <- IIBHT %>%
mutate(past_services_any = if_else(
(past_services_op_school == 1 | past_services_sud_treat == 1 |
past_services_wrap == 1 | past_services_juv_justice == 1 |
past_services_IDD == 1) & past_services_none == 0,
1, 0
))
# Looking at frequency of values in closure_reason variable
table(IIBHT$closure_reason)
# if category 5 is very small, combine with category 1 (n = 9)
# combine category 6 with 7 to have a general "all other reasons" category
IIBHT <- IIBHT %>%
mutate(
closure_reason = factor(
case_when(
closure_reason %in% c(1,5) ~ "Lower Level of Care Or Stable",
closure_reason == 2 ~ "Higher Level of Care",
closure_reason == 3 ~ "Youth/Family Stopped Engaging",
closure_reason == 4 ~ "Moved Out of Service Area",
TRUE ~ "Other/Unknown" #6, 7 and etc.
)
))
# Creating a vector of barriers_recommended_care
barriers_recommended_care <- c(
"barriers_recommended_care___1","barriers_recommended_care___2",
"barriers_recommended_care___3","barriers_recommended_care___4",
"barriers_recommended_care___5","barriers_recommended_care___6",
"barriers_recommended_care___7","barriers_recommended_care___8",
"barriers_recommended_care___9")
# Creating any_barrier, which equals 1 when any value in 1-9 are checked, equals 0 when all values in 1-9 are unchecked and 11 is unchecked, equals 2 when all values in 1-9 are unchecked but 11 is checked.
# 1 = "Yes", 0 = "No", 2 = "Unknown"
IIBHT <- IIBHT %>%
mutate(
any_barrier = case_when(
# If any barrier in the vector is 1
if_any(all_of(barriers_recommended_care), ~ .x == 1) ~ 1,
# If all barriers are 0 AND barrier 11 is 0
if_all(all_of(barriers_recommended_care), ~ .x == 0) &
barriers_recommended_care___11 == 0 ~ 0,
# If all barriers are 0 AND barrier 11 is 1
if_all(all_of(barriers_recommended_care), ~ .x == 0) &
barriers_recommended_care___11 == 1 ~ 2,
))
table(IIBHT$any_barrier)
