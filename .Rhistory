mutate(
household_language = case_when(
is.na(household_language) ~ "Unknown",
.default = household_language
)
)
IIBHT_outcome <- IIBHT_outcome %>%
mutate(
household_language = case_when(
is.na(household_language) ~ "Unknown",
.default = household_language
)
)
IIBHT_sud <- IIBHT_sud %>%
mutate(
household_language = case_when(
is.na(household_language) ~ "Unknown",
.default = household_language
)
)
