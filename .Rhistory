# Filtering where observations have nonmissing and old closure forms
IIBHT_outcome <- IIBHT %>%
filter(!is.na(closure_form_used) & closure_form_used != 3)
# Noting how many still remain in the dataset
subsetnrow <- nrow(IIBHT_outcome)
subsetnrow
# Outputting percentage still present
subsetnrow/ss3nrow * 100
# How many total were dropped?
totalDroppedsud <- originalnrow - subsetnrow
totalDroppedsud
# What percentage of observations were Dropped from the total?
totalDroppedsud/originalnrow * 100
# How many completed SUD screening at intake?
nrow_intakesud <- IIBHT_outcome %>%
filter( sud_screen_youth_complete.x == 2) %>%
nrow()
nrow_intakesud
# How many completed SUD screening at closure?
nrow_closuresud <- IIBHT_outcome %>%
filter( sud_screen_youth_complete.y == 2) %>%
nrow()
nrow_closuresud
# How many completed SUD screening at both intake and closure?
nrow_sud_in_clo <- IIBHT_outcome %>%
filter( sud_screen_youth_complete.x == 2 & sud_screen_youth_complete.y == 2) %>%
nrow()
nrow_sud_in_clo
# Including only both SUD screening @ intake and closure in next steps:
IIBHT_sud <- IIBHT_outcome %>%
filter(sud_screen_youth_complete.x == 2 & sud_screen_youth_complete.y == 2)
nrow(IIBHT_sud)
IIBHT_sud <- IIBHT_sud %>%
mutate(sud_any = as.integer(
sud_alcohol.x == 1 | sud_alcohol.y == 1 | sud_nicotine.x == 1 |
sud_nicotine.y == 1 | sud_drugs.x == 1 | sud_drugs.y == 1 |
sud_medication.x == 1 | sud_medication.y == 1
))
IIBHT_sud %>%
filter(sud_any == 1) %>%
nrow()
# Where sud_screen_youth_complete.x = 2 AND sud_total.x is NA, set sud_total.x to 0
IIBHT_sud<- IIBHT_sud %>%
mutate(
sud_total.x = as.numeric(sud_total.x),
sud_total.x = if_else(
sud_screen_youth_complete.x == 2 & is.na(sud_total.x), 0, sud_total.x
)
)
# Where sud_screen_youth_complete.y = 2 AND sud_total.y is NA, set sud_total.y to 0
IIBHT_sud <- IIBHT_sud %>%
mutate(
sud_total.y = as.numeric(sud_total.y),
sud_total.y = if_else(
sud_screen_youth_complete.y ==2 & is.na(sud_total.y), 0, sud_total.y
)
)
# Impute 0 if intake = 0 and closure is missing
IIBHT_sud <- IIBHT_sud %>%
mutate(
sud_total.y = if_else(
!is.na(sud_total.x) & sud_total.x == 0 & is.na(sud_total.y),
0, sud_total.y
))
#impute 0 if they screened positive at closure and intake is missing
IIBHT_sud <- IIBHT_sud %>%
mutate(
sud_total.x = if_else(
!is.na(sud_total.y) & sud_total.y > 0 & is.na(sud_total.x),
0, sud_total.x
))
# 3. For sud_any = 1:
# Note what % has sud_total.x completed who screened positive
# Of those with sud_screen_youth_complete.x = 2, how many sud_total.x is > 0?
intake_sud_positive <- IIBHT_sud %>%
filter(sud_screen_youth_complete.x == 2  & sud_total.x > 0) %>%
nrow()
intake_sud_positive
intake_sud_positive/nrow_intakesud * 100
# Note what % has sud_total.y completed who screened positive AND what % has both pre and post complete
# Of those with sud_screen_youth_complete.y = 2, how many sud_total.y is > 0?
closure_sud_positive <- IIBHT_sud %>%
filter(sud_screen_youth_complete.y == 2  & sud_total.y > 0) %>%
nrow()
closure_sud_positive
closure_sud_positive/nrow_closuresud * 100
# What percentage of full dataset have both x and y sud complete?
nrow_sud_in_clo / nrow(IIBHT) * 100
# What percentage of those discharged have both x and y sud complete?
nrow_sud_in_clo / nrow(IIBHT_outcome) * 100
# What percentage of this dataset have both x and y sud complete? (check)
nrow_sud_in_clo / nrow(IIBHT_sud) * 100
IIBHT_sud <- IIBHT_sud %>%
mutate(
change_in_sud_score = as.integer(sud_total.y) - as.integer(sud_total.x)
)
# Looking at variable to ensure proper calculation and imputation
str(IIBHT_sud$change_in_sud_score)
str(IIBHT_sud$sud_total.y) # reminder - closure
str(IIBHT_sud$sud_total.x) # reminder - intake
# Checking if the current imputations work
IIBHT_sud %>%
filter(xor(is.na(sud_total.x), is.na(sud_total.y)))
# Looking at values for change in sud score
range(IIBHT_sud$change_in_sud_score, na.rm = TRUE)
mean(IIBHT_sud$change_in_sud_score, na.rm = TRUE)
median(IIBHT_sud$change_in_sud_score, na.rm = TRUE)
# Combining missing and unknown categories for variables that need it
# household language
